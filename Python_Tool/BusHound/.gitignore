# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# PyInstaller build outputs and intermediate files
build/
dist/
*.spec
*.exe

# AP Key sensitive binaries (keep folder structure)
AP_Key/*.bin

# Explicitly track 7z archive
!BusHound.7z

# Node modules
node_modules/
package.json
package-lock.json

# Image assets and screenshots
assets/
*.png
*.jpg
*.jpeg

# Source code files
src/
