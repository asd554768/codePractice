# DeepSeek V4.1 Flash（2 台 GB300）
DEEPSEEK_BASE_URL=http://deepseek-node:8000/v1
DEEPSEEK_API_KEY=not-needed

# GLM-5.3 Flash（1~2 台 GB300）
GLM_BASE_URL=http://glm-node:8000/v1
GLM_API_KEY=not-needed

# Qwen 3.8-27B（1 台 GB300 綽綽有餘）
QWEN_27B_BASE_URL=http://qwen-27b-node:8000/v1
QWEN_27B_API_KEY=not-needed
